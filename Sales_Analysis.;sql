select * from sales;
--1.find all orders where the quantity sold is greater then 5.
select customer_name,quantity from sales where quantity>5;
--2.display the all productes and their prices ,staring from the highest price to lowest price
select product_name,price from sales order by price desc
--3.how many orders were placed in each regian
select region,count(*) from sales group by region	
--4.find the total quantity of products sold in each category
select sum(quantity) as total_quantity,category from sales group by category
--5.find the average product price for each category
select avg(price) as Average_price,category from sales group by category
--6.find the regions where the total quantity of products sold in greater then 20.
select region,sum(quantity) as Total_Quantity from sales group by region having sum(quantity)>20;
--7.find the total sales amount for each product
select product_name,sum(price*quantity) as sales_amount from sales group by product_name 
--8.Most expensive proiduct in the store
select product_name,price from sales where price =(select max(price)  from sales)limit 1
--9.find the productes whose price is greater then the average price of all productes
select order_id,product_name from sales where price >(select avg(price) from sales);
--10.find the customer who placed the order with the highest quantity
select customer_name as Highest_quantity_customer from sales where quantity =(select max(quantity) from sales);

